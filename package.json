{
  "name": "demo-web-app",
  "version": "1.0.0",
  "description": "A full-stack task management app",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "test": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.50.0",
    "concurrently": "^8.2.1"
  }
}